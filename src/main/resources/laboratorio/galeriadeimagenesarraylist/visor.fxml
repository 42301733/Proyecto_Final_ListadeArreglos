<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="1080.0" prefWidth="1920.0" styleClass="panelVisor" stylesheets="@estilo.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="laboratorio.galeriadeimagenesarraylist.visorController">

    <!-- CENTRO: IMAGEN + DATOS -->
    <center>

        <VBox alignment="CENTER" prefHeight="498.0" prefWidth="478.0" spacing="15">

            <ImageView fx:id="imagenes" fitHeight="688.0" fitWidth="860.0" preserveRatio="true" />

            <VBox alignment="CENTER" spacing="5">

                <Label fx:id="lblTitulo" styleClass="labelblanca" stylesheets="@estilo.css" text="Título" />
                <Label fx:id="lblMB" styleClass="labelblanca" stylesheets="@estilo.css" text="MB" />
                <Label fx:id="lblCategoria" styleClass="labelblanca" stylesheets="@estilo.css" text="Categoría" />
                <Label fx:id="lblBytes" styleClass="labelblanca" stylesheets="@estilo.css" text="Bytes" />
                <Label fx:id="lblFecha" styleClass="labelblanca" stylesheets="@estilo.css" text="Fecha" />

            </VBox>

        </VBox>

    </center>

    <!-- ABAJO: BOTONES -->
    <bottom>

        <HBox alignment="CENTER" spacing="50" style="-fx-padding: 15;" />

    </bottom>
   <left>

            <Button onAction="#anteriorImagen" styleClass="botonestransparentes" stylesheets="@estilo.css" text="‹" BorderPane.alignment="CENTER" />
   </left>
   <right>

         <Button onAction="#siguienteImagen" styleClass="botonestransparentes" stylesheets="@estilo.css" text="›" BorderPane.alignment="CENTER" />
   </right>
   <top>
      <Button fx:id="btnCerrar" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#cerrarVisor" prefHeight="45.0" prefWidth="52.0" stylesheets="@estilo.css" text="X" translateX="935.0" BorderPane.alignment="CENTER" />
   </top>

</BorderPane>

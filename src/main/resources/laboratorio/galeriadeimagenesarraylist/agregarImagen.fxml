<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="200.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="laboratorio.galeriadeimagenesfx.AgregarController">
   <children>
      <Label contentDisplay="CENTER" layoutX="14.0" layoutY="14.0" prefHeight="25.0" prefWidth="178.0" text="Agregar Nueva Imagen">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <TextField fx:id="txtRuta" layoutX="10.0" layoutY="45.0" prefHeight="37.0" prefWidth="480.0" promptText="https://ejemplo.com/imagen.jpg" />
      <TextField fx:id="txtTitulo" layoutX="14.0" layoutY="100.0" prefHeight="37.0" prefWidth="480.0" promptText="Título" />
      <Button layoutX="355.0" layoutY="161.0" mnemonicParsing="false" onAction="#cancelar" styleClass="buttonAgregar" stylesheets="@estilo.css" text="Cancelar" />
      <Button layoutX="431.0" layoutY="161.0" mnemonicParsing="false" onAction="#agregar" styleClass="buttonAgregar" stylesheets="@estilo.css" text="Agregar" />
   </children>
</AnchorPane>
